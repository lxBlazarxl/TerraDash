# Path to the directory containing Terraria server files
TERRARIA_DIR=/path/to/terraria/server

# Name of the Terraria server executable (e.g., TerrariaServer.exe or TerrariaServer.bin.x86_64)
TERRARIA_EXE=TerrariaServer.exe

# Directory holding the .wld world files. Leave blank to use
# ~/.local/share/Terraria/Worlds (the Linux dedicated server default).
TERRARIA_WORLDS_DIR=

# Web Dashboard API port (default 5000; must match client/vite.config.js proxy)
PORT=5000

# Interface to bind (default 127.0.0.1). Use 0.0.0.0 only behind a trusted proxy.
HOST=127.0.0.1

# Optional shared secret. When set, every /api request must send
# `Authorization: Bearer <token>`. Leave empty for local-only use.
DASHBOARD_TOKEN=
